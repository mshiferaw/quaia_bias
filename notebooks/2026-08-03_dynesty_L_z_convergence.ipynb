   "source": [
    "## Define functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "694a2c33-a61b-49e5-9311-3d2315e91f20",
   "metadata": {},
   "outputs": [],
   "source": [
    "def M(bins, n_m, a = 1, cosmo = cosmo_planck18, mod = False, recenter = True, hmf = hmf, units = '(h/Mpc)^3'):\n",
    "\n",
    "    n_g, nm = sampler.n_g_theory(bins, n_m, a = a, cosmo = cosmo, recenter = recenter, hmf = hmf, units = units)\n",
    "    if recenter == True:\n",
    "        n_g = np.trapz(n_g, quaia.recenter(bins))\n",
    "        dm = np.diff(bins) \n",
    "        dn_dm = nm/(quaia.recenter(bins)*np.log(10))\n",
    "    else:\n",
    "        n_g = np.trapz(n_g, bins)\n",
    "        dn_dm = nm/(bins*np.log(10))\n",
    "\n",
    "    n_m[~np.isfinite(n_m)]=0 \n",
    "    integrand = dn_dm*n_m\n",
    "    integrand[np.isnan(integrand)]=0\n",
    "    \n",
    "    if recenter == True:\n",
    "        return sampler.bias_function(n_g, integrand, quaia.recenter(bins), bins, recenter = recenter), n_g\n",
    "    else:\n",
    "        return sampler.bias_function(n_g, integrand, bins, bins, recenter = recenter), n_g"
   ]
  },
