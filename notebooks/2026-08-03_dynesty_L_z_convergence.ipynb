    "N_q, n_q = {L: [] for L in L_bins}, {L: [] for L in L_bins}\n",
    "H0_c_dN_dz_norm = {L: [] for L in L_bins}\n",
    "z_sigma = {L: [] for L in L_bins}\n",
    "\n",
    "for i in range(len(L_bins)):\n",
    "            \n",
