COMMENT $W1$ magnitude}                                                         COMMENT - {name: mag_w2_vg, unit: mag, datatype: float64, description: unWISE \ COMMENT $W2$ magnitude}                                                         COMMENT - {name: pm, unit: mas / yr, datatype: float64, description: total pro\ COMMENT per motion}                                                             COMMENT - {name: pmra, unit: mas / yr, datatype: float64, description: 'proper\ COMMENT  motion in right ascension $\mu_{\alpha*} \equiv \mu_\alpha \,          COMMENT     \mathrm{cos} \, \delta$ of the source in ICRS at 2016.0'}           COMMENT - {name: pmdec, unit: mas / yr, datatype: float64, description: 'prope\ COMMENT r motion in declination $\mu_{\delta}$ of the source in ICRS at         COMMENT     2016.0'}                                                            COMMENT - {name: pmra_error, unit: mas / yr, datatype: float32, description: s\ COMMENT tandard error of proper motion in right ascension direction}            COMMENT - {name: pmdec_error, unit: mas / yr, datatype: float32, description: \ COMMENT standard error of proper motion in declination direction}               COMMENT - {name: M_i, unit: mag, datatype: float64, description: '\emph{Gaia} \ COMMENT $G$-band mean magnitude'}                                               COMMENT meta:                                                                   COMMENT   __serialized_columns__: {}                                            COMMENT --END-ASTROPY-SERIALIZED-COLUMNS--                                      END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             